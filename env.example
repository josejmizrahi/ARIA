# ===========================================
# ARIA - Configuración de Entorno
# ===========================================
# Copia este archivo a .env y configura los valores

# Odoo Connection
# ---------------
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_db
ODOO_USER=admin
ODOO_PASSWORD=admin
ODOO_TIMEOUT=30
# ID de la compañía principal (para filtrar datos)
ODOO_COMPANY_ID=1
# Divisa por defecto para reportes
ODOO_DEFAULT_CURRENCY=MXN

# ARIA Settings
# -------------
ARIA_ENV=development
ARIA_DEBUG=true
ARIA_LOG_LEVEL=INFO
ARIA_LOG_DIR=./logs

# Redis (para almacenamiento de propuestas)
# -----------------------------------------
REDIS_URL=redis://localhost:6379/0

# Telegram Bot
# ------------
# 1. Habla con @BotFather en Telegram
# 2. Crea un nuevo bot con /newbot
# 3. Copia el token aquí
TELEGRAM_BOT_TOKEN=
# 4. Envía un mensaje a tu bot
# 5. Visita: https://api.telegram.org/bot<TOKEN>/getUpdates
# 6. Busca "chat":{"id": y copia el número
TELEGRAM_ADMIN_CHAT_ID=

# Email (opcional)
# ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=

# Notification Settings
# ---------------------
NOTIFICATION_CHANNEL=console
# Opciones: console, telegram, email

# Agent Settings
# --------------
AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY=5
APPROVAL_TIMEOUT_HOURS=24

# Finance Budget Settings (Opcional - Los presupuestos se pueden configurar desde el dashboard)
# --------------------------------------------------------------------------------------------
# Si prefieres configurar presupuestos desde variables de entorno en lugar del dashboard:
# FINANCE_BUDGET_MONTHLY_REVENUE=24500000
# FINANCE_BUDGET_MONTHLY_EXPENSES=17150000
# FINANCE_BUDGET_BY_CATEGORY='{"Ventas": 20000000, "Marketing": 2000000}'
# 
# NOTA: Los presupuestos se cargan automáticamente desde (en orden de prioridad):
# 1. Módulo account.budget de Odoo (si está disponible y configurado)
# 2. Configuración manual desde el dashboard web (/api/finance/budgets)
# 3. Cálculo automático basado en histórico (promedio de últimos 6 meses)
